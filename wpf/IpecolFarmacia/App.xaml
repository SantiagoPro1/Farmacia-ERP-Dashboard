<Application x:Class="IpecolFarmacia.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Paleta Oficial Institucional IPECOL y Colores Shell IUBI -->
    <Color x:Key="Wine950">#3D101C</Color>
    <Color x:Key="Wine900">#5A1829</Color>
    <Color x:Key="Wine800">#6E1F33</Color>
    <Color x:Key="Wine700">#812A3F</Color>
    <Color x:Key="Rose100">#F6E6E6</Color>
    <Color x:Key="Rose200">#EFD3D3</Color>
    <Color x:Key="Rose300">#D9A3A0</Color>
    <Color x:Key="Gold500">#B8955A</Color>
    <Color x:Key="Gold100">#F7ECD3</Color>
    <Color x:Key="Sand50">#FAF7F4</Color>
    <Color x:Key="Sand100">#EFE8E1</Color>
    <Color x:Key="Ink">#2B1B1E</Color>
    
    <!-- Colores Shell IUBI -->
    <Color x:Key="IubiDarkSlate">#2D3238</Color>
    <Color x:Key="IubiDarkerSlate">#22262B</Color>
    <Color x:Key="IubiHoverSlate">#383F47</Color>

    <SolidColorBrush x:Key="Wine950Brush" Color="{StaticResource Wine950}"/>
    <SolidColorBrush x:Key="Wine900Brush" Color="{StaticResource Wine900}"/>
    <SolidColorBrush x:Key="Wine800Brush" Color="{StaticResource Wine800}"/>
    <SolidColorBrush x:Key="Wine700Brush" Color="{StaticResource Wine700}"/>
    <SolidColorBrush x:Key="Rose100Brush" Color="{StaticResource Rose100}"/>
    <SolidColorBrush x:Key="Rose200Brush" Color="{StaticResource Rose200}"/>
    <SolidColorBrush x:Key="Rose300Brush" Color="{StaticResource Rose300}"/>
    <SolidColorBrush x:Key="Gold500Brush" Color="{StaticResource Gold500}"/>
    <SolidColorBrush x:Key="Gold100Brush" Color="{StaticResource Gold100}"/>
    <SolidColorBrush x:Key="Sand50Brush" Color="{StaticResource Sand50}"/>
    <SolidColorBrush x:Key="Sand100Brush" Color="{StaticResource Sand100}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
    <SolidColorBrush x:Key="IubiDarkSlateBrush" Color="{StaticResource IubiDarkSlate}"/>
    <SolidColorBrush x:Key="IubiDarkerSlateBrush" Color="{StaticResource IubiDarkerSlate}"/>
    <SolidColorBrush x:Key="IubiHoverSlateBrush" Color="{StaticResource IubiHoverSlate}"/>

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    </Style>

    <!-- Tarjeta Estándar -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Sand100Brush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#2B1B1E" BlurRadius="12" Opacity="0.05" ShadowDepth="2" Direction="270"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Wine950Brush}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#718096"/>
    </Style>

    <!-- Botones Primarios -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Wine800Brush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Wine700Brush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Wine950Brush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Rose300Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource Rose100Brush}"/>
      <Setter Property="Foreground" Value="{StaticResource Wine800Brush}"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{StaticResource Gold100Brush}"/>
      <Setter Property="Foreground" Value="{StaticResource Wine900Brush}"/>
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource Wine800Brush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Sand100Brush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Sand50Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botón Ghost / Sutil sin borde institucional -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Wine900Brush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Sand100Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botón de Navegación Lateral estilo Institucional IPECOL -->
    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#F6E6E6"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="8" Padding="14,10" Background="Transparent">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="›" FontSize="14" FontWeight="Bold" Foreground="#D9A3A0" VerticalAlignment="Center"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Wine800Brush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource Wine900Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Wine900Brush}"/>
          <Setter Property="FontWeight" Value="Bold"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Botón de Encabezado Superior (Ventana / Sistema) -->
    <Style x:Key="TopSystemButton" TargetType="Button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="#718096"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="btnBrd" Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="btnBrd" Property="Background" Value="#E2E8F0"/>
                <Setter Property="Foreground" Value="{StaticResource Wine800Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botones de Filtro (Chips) -->
    <Style x:Key="FilterChip" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Sand100Brush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource Rose100Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource Wine900Brush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Estilo Global de DataGrid con ScrollViewer optimizado para Scroll con Rueda del Ratón -->
    <Style TargetType="DataGrid">
      <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- Estilo de Cabecera de DataGrid -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource Sand50Brush}"/>
      <Setter Property="Foreground" Value="#718096"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{StaticResource Sand100Brush}"/>
    </Style>

    <!-- Estilo de Fila de DataGrid -->
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="{StaticResource Sand100Brush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Sand50Brush}"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource Rose100Brush}"/>
          <Setter Property="Foreground" Value="{StaticResource Wine950Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Wine950Brush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
