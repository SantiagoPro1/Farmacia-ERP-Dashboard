                  <Border Background="{StaticResource Sand50Brush}" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Width="400" HorizontalAlignment="Left">
                    <DockPanel>
                      <TextBlock Text="🔍 " FontSize="12" VerticalAlignment="Center" Foreground="#A0AEC0"/>
                      <TextBox Text="{Binding FiltroPacientes, UpdateSourceTrigger=PropertyChanged}" 
                               BorderThickness="0" Background="Transparent" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
