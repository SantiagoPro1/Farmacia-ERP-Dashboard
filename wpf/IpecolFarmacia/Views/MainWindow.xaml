            <StackPanel>
              <!-- Cabecera -->
              <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="📥 Exportar Reporte a Excel" Style="{StaticResource OutlineButton}"
                        Command="{Binding ExportarExcelCommand}" CommandParameter="Reporte_Actualizaciones_Cierres"/>
                <StackPanel>
                  <TextBlock Text="Actualizaciones y Cortes Diarios de Farmacia" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
                  <TextBlock Text="Consolidado de dispensaciones, absorción institucional (80%), cuotas cobradas en Base 0% y emisión de vales." Opacity="0.65" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>

              <!-- Barra Superior de Filtros estilo IUBI Captura 124845 -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="14">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Fecha Último Pago / Inicio -->
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="FECHA INICIAL" Style="{StaticResource Caption}"/>
                    <DatePicker Text="01/10/2026" Margin="0,4,0,0"/>
                  </StackPanel>

                  <!-- Fecha de Corte -->
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="FECHA DE CORTE" Style="{StaticResource Caption}"/>
                    <DatePicker Text="01/10/2026" Margin="0,4,0,0"/>
                  </StackPanel>

                  <!-- Turno -->
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="TURNO OPERATIVO" Style="{StaticResource Caption}"/>
                    <ComboBox SelectedIndex="0" Margin="0,4,0,0" Padding="8,5">
                      <ComboBoxItem Content="Matutino (07:00 - 15:00)"/>
                      <ComboBoxItem Content="Vespertino (14:00 - 21:00)"/>
                      <ComboBoxItem Content="Consolidado Diario"/>
                    </ComboBox>
                  </StackPanel>

                  <!-- Terminal / Caja -->
                  <StackPanel Grid.Column="6">
                    <TextBlock Text="TERMINAL / CAJA" Style="{StaticResource Caption}"/>
                    <ComboBox SelectedIndex="0" Margin="0,4,0,0" Padding="8,5">
                      <ComboBoxItem Content="Caja 02 (Ventanilla Central)"/>
                      <ComboBoxItem Content="Caja 01 (Urgencias)"/>
                      <ComboBoxItem Content="Todas las Cajas"/>
                    </ComboBox>
                  </StackPanel>

                  <!-- Botón Calcular Actualización (Verde / Vino según Captura 124845) -->
                  <Button Grid.Column="8" Content="Calcular Actualización" VerticalAlignment="Bottom" Height="34"
                          Background="#3BB54A" Foreground="White" FontWeight="Bold" FontSize="12" Padding="16,0" Cursor="Hand"
                          Command="{Binding CalcularReporteCommand}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="bCalc" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bCalc" Property="Background" Value="#329A3E"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
              </Border>

              <!-- Sección Cálculos Prominentes (Exacto a IUBI Captura 124845) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                  <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="💳  CÁLCULOS Y CONSOLIDADO DE CUOTAS" Style="{StaticResource CardTitle}" Margin="0"/>
                    <Border Background="{StaticResource Rose100Brush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                      <TextBlock Text="MODO AUDITADO · IUBIDB_FARMACIAS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}"/>
                    </Border>
                  </DockPanel>

                  <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.2*"/>
                      <ColumnDefinition Width="1.2*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Cobrado (Base 0%) -->
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Total por pagar (Pacientes):" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568"/>
                      <TextBlock Text="{Binding ReporteTotalCobrado}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}" Margin="0,4,0,0"/>
                      <TextBlock Text="Recaudación cuota recuperación" FontSize="10" Foreground="#718096"/>
                    </StackPanel>

                    <!-- Absorción Institucional IPECOL -->
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Absorción Generada (IPECOL):" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568"/>
                      <TextBlock Text="{Binding ReporteTotalAbsorcion}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Wine800Brush}" Margin="0,4,0,0"/>
                      <TextBlock Text="Subsidio médico 80% cubierto" FontSize="10" Foreground="#718096"/>
                    </StackPanel>

                    <!-- Recetas Surtidas -->
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Recetas Surtidas:" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568"/>
                      <TextBlock Text="{Binding ReporteRecetasSurtidas}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}" Margin="0,4,0,0"/>
                      <TextBlock Text="100% en Base 0% IVA" FontSize="10" Foreground="#38A169"/>
                    </StackPanel>

                    <!-- Vales Sugeridos -->
                    <StackPanel Grid.Column="3">
                      <TextBlock Text="Vales Emitidos:" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568"/>
                      <TextBlock Text="{Binding ReporteValesEmitidos}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Gold500Brush}" Margin="0,4,0,0"/>
                      <TextBlock Text="Red subrogada IPECOL" FontSize="10" Foreground="#718096"/>
                    </StackPanel>

                    <!-- Botón Guardar Cálculo -->
                    <Button Grid.Column="4" Content="Guardar Cálculo de Corte" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="16,10"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Tabla de Registros / Prestamos y Entregas con Actualizaciones -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,30">
                <StackPanel>
                  <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="📋  DISPENSACIONES Y MOVIMIENTOS CON ACTUALIZACIONES" Style="{StaticResource CardTitle}" Margin="0"/>
                    <TextBlock Text="Arrastre una columna aquí para agrupar por dicha columna" FontSize="11" Foreground="#A0AEC0" FontStyle="Italic" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                  </DockPanel>

                  <DataGrid ItemsSource="{Binding KardexFiltrado}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Sand100Brush}"
                            Background="White" RowBackground="White" RowHeight="46" BorderThickness="0"
                            MaxHeight="500" EnableRowVirtualization="True"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="FOLIO OPERACIÓN" Binding="{Binding DocumentoReferencia}" Width="150" FontWeight="Bold"/>
                      <DataGridTextColumn Header="FECHA / HORA" Binding="{Binding Fecha}" Width="135"/>
                      <DataGridTemplateColumn Header="FÁRMACO DISPENSADO" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Medicamento}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Medicamento}"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="LOTE" Binding="{Binding Lote}" Width="100"/>
                      <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadTexto}" Width="100" FontWeight="Bold"/>
                      <DataGridTextColumn Header="TIPO OPERACIÓN" Binding="{Binding TipoMovimiento}" Width="140"/>
                      <DataGridTemplateColumn Header="CAJERO / USUARIO" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Usuario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Usuario}"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>

  <!-- ============================================================== -->
  <!-- MODAL HOST: DIÁLOGOS INSTITUCIONALES (PARIDAD SISTEMA ANTERIOR) -->
  <!-- ============================================================== -->
  <Grid Visibility="{Binding HayModalAbierto, Converter={StaticResource BoolToVis}}" 
        Background="#8A1A202C" Panel.ZIndex="9999"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    
    <!-- 1. MODAL VISTA PREVIA E IMPRESIÓN DE TICKET -->
    <Border Visibility="{Binding EsModalTicketVisible, Converter={StaticResource BoolToVis}}"
            Background="White" CornerRadius="12" BorderBrush="{StaticResource Wine900Brush}" BorderThickness="1.5"
            MaxWidth="520" MinWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="22">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25" Opacity="0.35" ShadowDepth="4"/>
      </Border.Effect>
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4"
                  Command="{Binding CerrarModalTicketCommand}"/>
          <TextBlock Text="🧾 Ticket de Dispensación Oficial" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
        </DockPanel>

        <!-- Recibo Estilizado Formato Térmico 80mm -->
        <Border Background="#FDFBF7" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="INSTITUTO DE PENSIONES DEL ESTADO DE COLIMA" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource Wine900Brush}"/>
            <TextBlock Text="FARMACIA INSTITUCIONAL · DISPENSACIÓN" FontSize="10" HorizontalAlignment="Center" Foreground="#718096" Margin="0,2,0,8"/>
            <Separator Margin="0,0,0,8" Background="{StaticResource Sand100Brush}"/>

            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding TicketActual.FolioTicket, StringFormat='Folio: {0}'}" FontSize="11" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="{Binding TicketActual.FechaHora}" FontSize="10" HorizontalAlignment="Right" Foreground="#4A5568"/>
            </Grid>

            <TextBlock Text="{Binding TicketActual.PacienteNombre, StringFormat='Paciente: {0}'}" FontSize="11" FontWeight="SemiBold" Margin="0,2"/>
            <TextBlock Text="{Binding TicketActual.Carnet, StringFormat='Carnet: {0}'}" FontSize="10" Foreground="#4A5568"/>
            <TextBlock Text="{Binding TicketActual.MedicoNombre, StringFormat='Médico: {0}'}" FontSize="10" Foreground="#4A5568"/>
            <TextBlock Text="{Binding TicketActual.FolioReceta, StringFormat='Receta: {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Wine900Brush}" Margin="0,0,0,6"/>

            <Separator Margin="0,4,0,6" Background="{StaticResource Sand100Brush}"/>
            <TextBlock Text="PARTIDAS DISPENSADAS:" FontSize="10" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding TicketActual.PartidasEntregadas}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,2">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Importe, StringFormat=C}" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Prescrita, StringFormat='[{0} pza] '}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}"/>
                    <TextBlock Text="{Binding Nombre}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,6,0,6" Background="{StaticResource Sand100Brush}"/>
            <DockPanel Margin="0,2">
              <TextBlock DockPanel.Dock="Right" Text="{Binding TicketActual.Subtotal, StringFormat=C}" FontSize="11"/>
              <TextBlock Text="SUBTOTAL:" FontSize="10" Foreground="#718096"/>
            </DockPanel>
            <DockPanel Margin="0,2">
              <TextBlock DockPanel.Dock="Right" Text="{Binding TicketActual.Absorcion, StringFormat='- {0:C}'}" FontSize="11" Foreground="#2F855A" FontWeight="SemiBold"/>
              <TextBlock Text="APOYO IPECOL (PRESTACIÓN 71.46%):" FontSize="10" Foreground="#2F855A"/>
            </DockPanel>
            <DockPanel Margin="0,4,0,2">
              <TextBlock DockPanel.Dock="Right" Text="{Binding TicketActual.AportacionPaciente, StringFormat=C}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}"/>
              <TextBlock Text="TOTAL COPAGO PACIENTE:" FontSize="12" FontWeight="Bold"/>
            </DockPanel>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cerrar" Style="{StaticResource OutlineButton}" Command="{Binding CerrarModalTicketCommand}" Margin="0,0,10,0"/>
          <Button Content="🖨️ Enviar a Impresora Térmica" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmarImpresionTermicaCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 2. MODAL CANCELAR RECETA (PrescriptionCancelWindow) -->
    <Border Visibility="{Binding EsModalCancelarRecetaVisible, Converter={StaticResource BoolToVis}}"
            Background="White" CornerRadius="12" BorderBrush="#E53E3E" BorderThickness="1.5"
            MaxWidth="520" MinWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="22">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25" Opacity="0.35" ShadowDepth="4"/>
      </Border.Effect>
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4"
                  Command="{Binding CerrarModalCancelarRecetaCommand}"/>
          <TextBlock Text="❌ Cancelar Receta Surtida" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="#9B2C2C"/>
        </DockPanel>

        <TextBlock Text="Esta función anula el surtimiento de la receta y reingresa automáticamente las piezas al inventario disponible de FARMACIA." FontSize="11" Foreground="#4A5568" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <TextBlock Text="FOLIO DE LA RECETA A ANULAR" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding FolioRecetaCancelar, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,10" FontWeight="Bold" FontSize="13"/>

        <TextBlock Text="MOTIVO DE CANCELACIÓN" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding MotivoCancelacion, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,14" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

        <Border Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,16">
          <TextBlock Text="⚠️ Acción auditada: El movimiento quedará asentado en el Kardex institucional de IUBIDB_FARMACIAS." FontSize="10" Foreground="#C53030"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Volver" Style="{StaticResource OutlineButton}" Command="{Binding CerrarModalCancelarRecetaCommand}" Margin="0,0,10,0"/>
          <Button Content="Confirmar Cancelación &amp; Reingreso" Background="#E53E3E" Foreground="White" BorderThickness="0" Padding="16,8" Cursor="Hand"
                  Command="{Binding ConfirmarCancelarRecetaCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 3. MODAL REIMPRESIÓN DE DOCUMENTO (ReprintDocumentWindow) -->
    <Border Visibility="{Binding EsModalReimpresionVisible, Converter={StaticResource BoolToVis}}"
            Background="White" CornerRadius="12" BorderBrush="{StaticResource Wine900Brush}" BorderThickness="1.5"
            MaxWidth="480" MinWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="22">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25" Opacity="0.35" ShadowDepth="4"/>
      </Border.Effect>
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4"
                  Command="{Binding CerrarModalReimpresionCommand}"/>
          <TextBlock Text="🖨️ Reimprimir Documento Oficial" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
        </DockPanel>

        <TextBlock Text="Emisión de duplicados autorizados de Tickets de Ventanilla o Vales de Subrogación." FontSize="11" Foreground="#4A5568" Margin="0,0,0,14"/>

        <TextBlock Text="NÚMERO DE FOLIO (TICKET O VALE)" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding FolioReimpresion, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,4,0,16" FontWeight="Bold" FontSize="13"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancelar" Style="{StaticResource OutlineButton}" Command="{Binding CerrarModalReimpresionCommand}" Margin="0,0,10,0"/>
          <Button Content="Buscar &amp; Reimprimir" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmarReimpresionCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 4. MODAL NUEVA ENTRADA / RECEPCIÓN (EntradaDeMedicamentos) -->
    <Border Visibility="{Binding EsModalNuevaEntradaVisible, Converter={StaticResource BoolToVis}}"
            Background="White" CornerRadius="12" BorderBrush="{StaticResource Wine900Brush}" BorderThickness="1.5"
            MaxWidth="560" MinWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="22">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25" Opacity="0.35" ShadowDepth="4"/>
      </Border.Effect>
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4"
                  Command="{Binding CerrarModalNuevaEntradaCommand}"/>
          <TextBlock Text="📦 Recepción de Medicamentos" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
        </DockPanel>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="NO. FACTURA / ORDEN" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding EntradaFacturaFolio, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="PROVEEDOR ACREDITADO" Style="{StaticResource Caption}"/>
            <ComboBox ItemsSource="{Binding ProveedoresList}" SelectedItem="{Binding ProveedorSeleccionado}"
                      DisplayMemberPath="DisplayText" Height="26" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="MEDICAMENTO A INGRESAR" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding EntradaMedicamento, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,10"/>

        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="LOTE" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding EntradaLote, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="CADUCIDAD" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding EntradaCaducidad, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="PIEZAS" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding EntradaCantidad, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="6">
            <TextBlock Text="COSTO U." Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding EntradaCosto, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancelar" Style="{StaticResource OutlineButton}" Command="{Binding CerrarModalNuevaEntradaCommand}" Margin="0,0,10,0"/>
          <Button Content="Registrar Entrada" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarNuevaEntradaCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 5. MODAL NUEVO AFILIADO (AddTitularWindow) -->
    <Border Visibility="{Binding EsModalNuevoAfiliadoVisible, Converter={StaticResource BoolToVis}}"
            Background="White" CornerRadius="12" BorderBrush="{StaticResource Wine900Brush}" BorderThickness="1.5"
            MaxWidth="500" MinWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="22">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25" Opacity="0.35" ShadowDepth="4"/>
      </Border.Effect>
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4"
                  Command="{Binding CerrarModalNuevoAfiliadoCommand}"/>
          <TextBlock Text="👤 Alta de Afiliado Titular" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
        </DockPanel>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="NO. CARNET" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding NuevoAfiliadoCarnet, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="CURP" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding NuevoAfiliadoCurp, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="NOMBRE COMPLETO (APELLIDOS Y NOMBRES)" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding NuevoAfiliadoNombre, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,10"/>

        <TextBlock Text="DEPENDENCIA / INSTITUCIÓN" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding NuevoAfiliadoDependencia, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancelar" Style="{StaticResource OutlineButton}" Command="{Binding CerrarModalNuevoAfiliadoCommand}" Margin="0,0,10,0"/>
          <Button Content="Guardar en Padrón" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarNuevoAfiliadoCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 6. MODAL NUEVO MÉDICO (AddDoctorsWindows) -->
    <Border Visibility="{Binding EsModalNuevoMedicoVisible, Converter={StaticResource BoolToVis}}"
            Background="White" CornerRadius="12" BorderBrush="{StaticResource Wine900Brush}" BorderThickness="1.5"
            MaxWidth="480" MinWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="22">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25" Opacity="0.35" ShadowDepth="4"/>
      </Border.Effect>
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4"
                  Command="{Binding CerrarModalNuevoMedicoCommand}"/>
          <TextBlock Text="🩺 Acreditación de Médico" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
        </DockPanel>

        <TextBlock Text="NOMBRE DEL MÉDICO (CON TÍTULO)" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding NuevoMedicoNombre, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,10"/>

        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="CÉDULA PROFESIONAL" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding NuevoMedicoCedula, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="ESPECIALIDAD" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding NuevoMedicoEspecialidad, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancelar" Style="{StaticResource OutlineButton}" Command="{Binding CerrarModalNuevoMedicoCommand}" Margin="0,0,10,0"/>
          <Button Content="Acreditar Médico" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarNuevoMedicoCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- 7. MODAL NUEVO MEDICAMENTO (AddArticleWindow) -->
    <Border Visibility="{Binding EsModalNuevoMedicamentoVisible, Converter={StaticResource BoolToVis}}"
            Background="White" CornerRadius="12" BorderBrush="{StaticResource Wine900Brush}" BorderThickness="1.5"
            MaxWidth="500" MinWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="22">
      <Border.Effect>
        <DropShadowEffect BlurRadius="25" Opacity="0.35" ShadowDepth="4"/>
      </Border.Effect>
      <StackPanel>
        <DockPanel Margin="0,0,0,12">
          <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4"
                  Command="{Binding CerrarModalNuevoMedicamentoCommand}"/>
          <TextBlock Text="💊 Alta de Fármaco en Catálogo" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
        </DockPanel>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="CLAVE CUADRO BÁSICO" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding NuevoMedClave, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="COSTO INSTITUCIONAL" Style="{StaticResource Caption}"/>
            <TextBox Text="{Binding NuevoMedCosto, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,0"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="DESCRIPCIÓN DEL FÁRMACO &amp; PRESENTACIÓN" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding NuevoMedNombre, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,10"/>

        <TextBlock Text="SUSTANCIA ACTIVA" Style="{StaticResource Caption}"/>
        <TextBox Text="{Binding NuevoMedSustancia, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,3,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancelar" Style="{StaticResource OutlineButton}" Command="{Binding CerrarModalNuevoMedicamentoCommand}" Margin="0,0,10,0"/>
          <Button Content="Guardar Fármaco" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarNuevoMedicamentoCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

  </Grid>
</Grid>
</Window>
