                  </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Card}" Padding="14,12">
                  <StackPanel>
                    <TextBlock Text="EN DESABASTO (VALES)" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding InventarioDesabasto}" FontWeight="Bold" FontSize="18" Foreground="#E53E3E" Margin="0,4,0,0"/>
