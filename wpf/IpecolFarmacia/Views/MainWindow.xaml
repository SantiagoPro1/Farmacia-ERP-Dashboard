                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Todos" Style="{StaticResource FilterChip}" Command="{Binding FiltrarInventarioPorCategoriaCommand}" CommandParameter="Todos"/>
                    <Button Content="En Stock" Style="{StaticResource FilterChip}" Command="{Binding FiltrarInventarioPorCategoriaCommand}" CommandParameter="EnStock"/>
                    <Button Content="Stock Crítico" Style="{StaticResource FilterChip}" Command="{Binding FiltrarInventarioPorCategoriaCommand}" CommandParameter="Critico"/>
                    <Button Content="Por Caducar FEFO" Style="{StaticResource FilterChip}" Command="{Binding FiltrarInventarioPorCategoriaCommand}" CommandParameter="PorCaducar"/>
                    <Button Content="Agotados" Style="{StaticResource FilterChip}" Command="{Binding FiltrarInventarioPorCategoriaCommand}" CommandParameter="Agotados"/>
                  </StackPanel>

                  <!-- Input de Búsqueda -->
                  <Border Background="{StaticResource Sand50Brush}" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Width="380" HorizontalAlignment="Left">
                    <DockPanel>
                      <TextBlock Text="🔍 " FontSize="12" VerticalAlignment="Center" Foreground="#A0AEC0"/>
                      <TextBox Text="{Binding FiltroInventario, UpdateSourceTrigger=PropertyChanged}" 
                               BorderThickness="0" Background="Transparent" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                </DockPanel>
              </Border>

              <!-- Tabla de Inventario FEFO -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,25">
