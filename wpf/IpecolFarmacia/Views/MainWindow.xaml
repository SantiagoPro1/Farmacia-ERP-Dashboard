<Window x:Class="IpecolFarmacia.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IpecolFarmacia.ViewModels"
        Title="IPECOL · Farmacia Institucional · IUBIDB_FARMACIAS" 
        Width="1440" Height="900" MinWidth="1200" MinHeight="750"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{StaticResource Sand50Brush}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- Estilos para conmutar las Vistas según VistaActual -->
    <Style x:Key="VentanillaViewStyle" TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding VistaActual}" Value="Ventanilla">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ValesViewStyle" TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding VistaActual}" Value="Vales">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="InventarioViewStyle" TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding VistaActual}" Value="Inventario">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="KardexViewStyle" TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding VistaActual}" Value="Kardex">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ComprasViewStyle" TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding VistaActual}" Value="Compras">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PacientesViewStyle" TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding VistaActual}" Value="Pacientes">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReportesViewStyle" TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding VistaActual}" Value="Reportes">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BienvenidaViewStyle" TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Pestanas.Count}" Value="0">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Window.DataContext>
    <vm:VentanillaViewModel/>
  </Window.DataContext>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="5"/>
      <!-- 2. Barra Superior Global estilo IUBI -->
      <RowDefinition Height="46"/>
      <!-- 3. Contenido Principal (Sidebar + Workspace) -->
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ======================================================== -->
    <!-- 1. LÍNEA SUPERIOR DE ACENTO (DRAGGABLE PARA MOVER VENTANA) -->
    <!-- ======================================================== -->
    <Border Grid.Row="0" Background="{StaticResource Wine800Brush}" MouseLeftButtonDown="TopLine_MouseLeftButtonDown" Cursor="SizeAll"/>

    <!-- ======================================================== -->
    <!-- 2. BARRA DE TÍTULO SUPERIOR (ESTILO IUBI CON NOMBRE CENTRADO) -->
    <!-- ======================================================== -->
    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="0,0,0,1" Padding="14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Izquierda: Módulo Activo y Migas de Pan -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource Rose100Brush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
            <TextBlock Text="FARMACIA" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Wine900Brush}"/>
          </Border>
          <TextBlock Text="{Binding VistaActual}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Wine950Brush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Centro: Nombre del Usuario Activo Real Autenticado -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding UsuarioNombreCompleto}" FontWeight="Bold" FontSize="13" Foreground="#4A5568"/>
          <TextBlock Text=" · " FontSize="13" Foreground="#A0AEC0"/>
          <TextBlock Text="{Binding UsuarioPerfilInfo}" FontSize="11" Foreground="#718096" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Derecha: Botones de Sistema estilo IUBI -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Notificaciones -->
          <Button Style="{StaticResource TopSystemButton}" ToolTip="Notificaciones de Farmacia">
            <TextBlock Text="🔔" FontSize="12"/>
          </Button>

          <!-- Configuración -->
          <Button Style="{StaticResource TopSystemButton}" ToolTip="Configuración general">
            <TextBlock Text="⚙" FontSize="14"/>
          </Button>

          <!-- Cambiar Contraseña -->
          <Button Style="{StaticResource TopSystemButton}" ToolTip="Cambiar contraseña de acceso" Click="BtnCambiarContrasenia_Click">
            <TextBlock Text="🔑" FontSize="12"/>
          </Button>

          <!-- Cerrar Sesión -->
          <Button Style="{StaticResource TopSystemButton}" ToolTip="Cerrar sesión" Click="BtnCerrarSesion_Click">
            <TextBlock Text="🚪" FontSize="13"/>
          </Button>

          <Border Width="1" Height="18" Background="#E2E8F0" Margin="4,0,8,0"/>

          <!-- Minimizar -->
          <Button Style="{StaticResource TopSystemButton}" ToolTip="Minimizar ventana" Click="BtnMinimizar_Click">
            <TextBlock Text="—" FontSize="12" FontWeight="Bold"/>
          </Button>

          <!-- Maximizar / Restaurar -->
          <Button Style="{StaticResource TopSystemButton}" ToolTip="Maximizar ventana" Click="BtnMaximizar_Click">
            <TextBlock Text="🗖" FontSize="11"/>
          </Button>

          <!-- Botón de Apagado / Salir (Rojo institucional exacto a IUBI) -->
          <Button Width="32" Height="32" Background="#B22222" BorderBrush="{x:Null}" Padding="0" Cursor="Hand" Margin="2,0,0,0" ToolTip="Salir del Sistema" Click="BtnSalir_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                  <Path Data="M 12,3 L 12,10 M 6.5,6.5 A 7,7 0 1 0 17.5,6.5" 
                        Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ======================================================== -->
    <!-- 3. CUERPO PRINCIPAL (SIDEBAR ESTILO IUBI + ÁREA DE VISTAS) -->
    <!-- ======================================================== -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- BARRA LATERAL INSTITUCIONAL IPECOL (VINO #5A1829 CON LOGO ROJITO OFICIAL EN TARJETA BLANCA) -->
      <Border Grid.Column="0" Background="{StaticResource Wine900Brush}">
        <DockPanel>
          <!-- Logo Superior IPECOL (El rojito oficial de assets en tarjeta blanca nítida) -->
          <Border DockPanel.Dock="Top" Background="#3D101C" Padding="14,14" BorderThickness="0,0,0,1" BorderBrush="#6E1F33">
            <StackPanel HorizontalAlignment="Center">
              <!-- Tarjeta blanca nítida para el logo rojito oficial -->
              <Border Background="White" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                <Image Source="/Assets/ipecol-full.png" MaxHeight="60" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Border>
              <Border Background="{StaticResource Gold100Brush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center">
                <TextBlock Text="FARMACIA INSTITUCIONAL" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Estado de Base de Datos en el pie de página -->
          <Border DockPanel.Dock="Bottom" Background="#3D101C" Padding="14,10" BorderThickness="0,1,0,0" BorderBrush="#6E1F33">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="🟢" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="IUBIDB_FARMACIAS" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="10.10.24.247 · Solo Lectura" FontSize="9" Foreground="#D9A3A0"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Menú de Módulos (Estilo institucional con selección en pastilla blanca) -->
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,6,0,0">
              <TextBlock Text="OPERACIÓN" FontSize="10" FontWeight="Bold" Foreground="#D9A3A0" Margin="16,10,16,6"/>

              <RadioButton Content="🏪  VENTANILLA &amp; RECETAS" Style="{StaticResource NavButton}" GroupName="nav" 
                           Visibility="{Binding PuedeVerVentanilla, Converter={StaticResource BoolToVis}}"
                           IsChecked="{Binding EsVistaVentanilla, Mode=OneWay}"
                           Command="{Binding AbrirPestanaCommand}" CommandParameter="Ventanilla"/>

              <RadioButton Content="🎫  SURTIDO DE VALES" Style="{StaticResource NavButton}" GroupName="nav"
                           Visibility="{Binding PuedeVerVales, Converter={StaticResource BoolToVis}}"
                           IsChecked="{Binding EsVistaVales, Mode=OneWay}"
                           Command="{Binding AbrirPestanaCommand}" CommandParameter="Vales"/>

              <RadioButton Content="📦  INVENTARIO &amp; LOTES (FEFO)" Style="{StaticResource NavButton}" GroupName="nav"
                           Visibility="{Binding PuedeVerInventario, Converter={StaticResource BoolToVis}}"
                           IsChecked="{Binding EsVistaInventario, Mode=OneWay}"
                           Command="{Binding AbrirPestanaCommand}" CommandParameter="Inventario"/>

              <TextBlock Text="GESTIÓN &amp; REPORTES" FontSize="10" FontWeight="Bold" Foreground="#D9A3A0" Margin="16,14,16,6"/>

              <RadioButton Content="👥  PADRÓN DERECHOHABIENTES" Style="{StaticResource NavButton}" GroupName="nav"
                           Visibility="{Binding PuedeVerPacientes, Converter={StaticResource BoolToVis}}"
                           IsChecked="{Binding EsVistaPacientes, Mode=OneWay}"
                           Command="{Binding AbrirPestanaCommand}" CommandParameter="Pacientes"/>

              <RadioButton Content="📋  KARDEX AUDITABLE" Style="{StaticResource NavButton}" GroupName="nav"
                           Visibility="{Binding PuedeVerKardex, Converter={StaticResource BoolToVis}}"
                           IsChecked="{Binding EsVistaKardex, Mode=OneWay}"
                           Command="{Binding AbrirPestanaCommand}" CommandParameter="Kardex"/>

              <RadioButton Content="🚚  ENTRADAS POR COMPRA" Style="{StaticResource NavButton}" GroupName="nav"
                           Visibility="{Binding PuedeVerCompras, Converter={StaticResource BoolToVis}}"
                           IsChecked="{Binding EsVistaCompras, Mode=OneWay}"
                           Command="{Binding AbrirPestanaCommand}" CommandParameter="Compras"/>

              <RadioButton Content="📊  REPORTES &amp; CIERRES" Style="{StaticResource NavButton}" GroupName="nav"
                           Visibility="{Binding PuedeVerReportes, Converter={StaticResource BoolToVis}}"
                           IsChecked="{Binding EsVistaReportes, Mode=OneWay}"
                           Command="{Binding AbrirPestanaCommand}" CommandParameter="Reportes"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ======================================================== -->
      <!-- ÁREA DE TRABAJO (PESTAÑAS MULTI-VENTANA + VISTAS OPERATIVAS) -->
      <!-- ======================================================== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <!-- 1. Barra de Pestañas Multi-Ventana estilo IUBI -->
          <RowDefinition Height="Auto"/>
          <!-- 2. Contenido de la Ventana Activa -->
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA DE PESTAÑAS (MDI DOCUMENT TABS ESTILO IUBI EN VINO Y ORO) -->
        <Border Grid.Row="0" Background="#EFE8E1" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="0,0,0,1" Padding="12,6,12,0">
          <DockPanel>
            <!-- Botón rápido para abrir pestaña de reportes -->
            <Button DockPanel.Dock="Right" Style="{StaticResource TopSystemButton}" ToolTip="Abrir otra pestaña" Margin="6,0,0,6"
                    Command="{Binding AbrirPestanaCommand}" CommandParameter="Reportes">
              <TextBlock Text="➕" FontSize="11" Foreground="{StaticResource Wine900Brush}"/>
            </Button>

            <!-- Tira Dinámica de Pestañas Abiertas -->
            <ItemsControl ItemsSource="{Binding Pestanas}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,4,0" CornerRadius="6,6,0,0" Padding="14,7" Cursor="Hand" BorderThickness="1,1,1,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <!-- Pestaña Inactiva -->
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Sand100Brush}"/>
                        <Style.Triggers>
                          <!-- Pestaña Activa (Vino Institucional) -->
                          <DataTrigger Binding="{Binding EsActiva}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Wine900Brush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Wine900Brush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>

                    <Border.InputBindings>
                      <MouseBinding Gesture="LeftClick" 
                                    Command="{Binding DataContext.SeleccionarPestanaCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                    CommandParameter="{Binding}"/>
                    </Border.InputBindings>

                    <DockPanel>
                      <!-- Botón de Cerrar Pestaña '✕' -->
                      <Button DockPanel.Dock="Right" Margin="8,0,0,0" Cursor="Hand" Width="16" Height="16"
                              Visibility="{Binding EsCerrable, Converter={StaticResource BoolToVis}}"
                              Command="{Binding DataContext.CerrarPestanaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="bClose" CornerRadius="3" Background="Transparent">
                              <TextBlock Text="✕" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#A0AEC0"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                        <Setter Property="Foreground" Value="#EFD3D3"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bClose" Property="Background" Value="#812A3F"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>

                      <!-- Icono y Título de la Pestaña -->
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icono}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Titulo}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource Wine900Brush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding EsActiva}" Value="True">
                                  <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Mensaje de estado cuando no hay ventanas abiertas -->
            <TextBlock Text="Ninguna ventana abierta — Selecciona una opción del menú lateral para comenzar" 
                       FontSize="11" Foreground="#718096" FontStyle="Italic" VerticalAlignment="Center" Margin="10,0,0,6">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Pestanas.Count}" Value="0">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DockPanel>
        </Border>

        <!-- ======================================================== -->
        <!-- ÁREA DE CONTENIDO / VISTAS OPERATIVAS (ERP EN VINO Y ORO) -->
        <!-- ======================================================== -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="MainScrollViewer_PreviewMouseWheel">
          <Grid Margin="20,16,20,40">

            <!-- ======================================================== -->
            <!-- 0. VISTA: BIENVENIDA / SIN VENTANAS ABIERTAS (Inicio Limpio) -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource BienvenidaViewStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="820" Margin="0,30,0,30">
              <StackPanel HorizontalAlignment="Center">
                <!-- Logotipo e Icono Principal -->
                <Border Background="White" CornerRadius="12" Padding="20,16" Margin="0,0,0,16" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="1" HorizontalAlignment="Center">
                  <Image Source="/Assets/ipecol-full.png" MaxHeight="80" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <TextBlock Text="Sistema ERP de Farmacia Institucional" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}" HorizontalAlignment="Center"/>
                <TextBlock FontSize="13" Foreground="#718096" HorizontalAlignment="Center" Margin="0,6,0,24">
                  <Run Text="Sesión activa iniciada como: "/>
                  <Run Text="{Binding UsuarioNombreCompleto}" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}"/>
                  <Run Text=" · Conectado en Modo Solo Lectura a IUBIDB_FARMACIAS"/>
                </TextBlock>

                <!-- Tarjetas de Acceso Rápido para Abrir Módulos -->
                <TextBlock Text="Seleccione un módulo operativo en el menú lateral o haga clic en un acceso rápido para comenzar:" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="180"/>
                  </Grid.ColumnDefinitions>

                  <!-- 1. Abrir Ventanilla -->
                  <Button Grid.Column="0" Style="{StaticResource OutlineButton}" Padding="16,20" Command="{Binding AbrirPestanaCommand}" CommandParameter="Ventanilla">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="🏪" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                      <TextBlock Text="Ventanilla" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Wine900Brush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="Dispensar Recetas" FontSize="10" Foreground="#718096" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Button>

                  <!-- 2. Abrir Inventario -->
                  <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Padding="16,20" Command="{Binding AbrirPestanaCommand}" CommandParameter="Inventario">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="📦" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                      <TextBlock Text="Inventario FEFO" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Wine900Brush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="Lotes y Existencias" FontSize="10" Foreground="#718096" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Button>

                  <!-- 3. Abrir Vales -->
                  <Button Grid.Column="4" Style="{StaticResource OutlineButton}" Padding="16,20" Command="{Binding AbrirPestanaCommand}" CommandParameter="Vales">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="🎫" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                      <TextBlock Text="Vales Subrogados" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Wine900Brush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="Canjes y Surtido" FontSize="10" Foreground="#718096" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Button>

                  <!-- 4. Abrir Padrón -->
                  <Button Grid.Column="6" Style="{StaticResource OutlineButton}" Padding="16,20" Command="{Binding AbrirPestanaCommand}" CommandParameter="Pacientes">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="👥" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                      <TextBlock Text="Padrón Afiliados" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Wine900Brush}" HorizontalAlignment="Center"/>
                      <TextBlock Text="Vigencias y Carnets" FontSize="10" Foreground="#718096" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- 1. VISTA: VENTANILLA DE DISPENSACIÓN Y FACTURACIÓN BASE 0% -->
            <!-- ======================================================== -->
            <Border Style="{StaticResource VentanillaViewStyle}">
              <StackPanel>
                <!-- Cabecera de la operación -->
                <DockPanel Margin="0,0,0,14">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                      <TextBlock Text="{Binding FechaHoraActual, StringFormat='🕒 {0}'}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource InkBrush}"/>
                    </Border>
                    <Button Content="🧾 Ver / Imprimir Ticket" Style="{StaticResource OutlineButton}" Command="{Binding AbrirModalTicketCommand}" Margin="0,0,8,0"/>
                    <Button Content="❌ Cancelar Receta" Style="{StaticResource OutlineButton}" Command="{Binding AbrirModalCancelarRecetaCommand}" Margin="0,0,8,0"/>
                    <Button Content="🖨️ Reimprimir Doc." Style="{StaticResource OutlineButton}" Command="{Binding AbrirModalReimpresionCommand}" Margin="0,0,8,0"/>
                    <Button Content="+ Nueva Operación" Style="{StaticResource PrimaryButton}" Command="{Binding NuevaOperacionCommand}"/>
                  </StackPanel>

                  <StackPanel>
                    <TextBlock Text="Ventanilla de Dispensación y Facturación Inmediata" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
                    <TextBlock Text="Valida al derechohabiente, surte la receta y registra el cobro en una sola operación (Base 0% IVA)." Opacity="0.65" FontSize="12" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>

                <!-- Tarjetas de Métricas de la Operación (Exacto a Cálculos Prominentes en IUBI Captura 124845) -->
                <Grid Margin="0,0,0,16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Total por Pagar (Paciente) -->
                  <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                      <TextBlock Text="TOTAL A PAGAR (PACIENTE)" Style="{StaticResource Caption}"/>
                      <TextBlock Text="{Binding AportacionPaciente, StringFormat={}{0:C}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}" Margin="0,3,0,0"/>
                      <TextBlock Text="Base 0% IVA · Cuota Recuperación" FontSize="9.5" Foreground="#718096" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>

                  <!-- Absorción Instituto (80%) -->
                  <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                      <TextBlock Text="ABSORCIÓN INSTITUTO (80%)" Style="{StaticResource Caption}"/>
                      <TextBlock Text="{Binding Absorcion, StringFormat={}{0:C}}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Wine800Brush}" Margin="0,3,0,0"/>
                      <TextBlock Text="Prestación Médica IPECOL" FontSize="9.5" Foreground="#718096" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>

                  <!-- Partidas Receta -->
                  <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                      <TextBlock Text="SURTIDO EN VENTANILLA" Style="{StaticResource Caption}"/>
                      <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}" Margin="0,3,0,0">
                        <Run Text="{Binding Partidas.Count, Mode=OneWay}"/>
                        <Run Text=" Partidas Presc." FontSize="11" Foreground="#718096"/>
                      </TextBlock>
                      <TextBlock Text="Existencias y vales calculados" FontSize="9.5" Foreground="{StaticResource Gold500Brush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>

                  <!-- Folio Receta Activa -->
                  <Border Grid.Column="6" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                      <TextBlock Text="FOLIO RECETA ACTIVA" Style="{StaticResource Caption}"/>
                      <TextBlock Text="{Binding FolioReceta}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}" Margin="0,4,0,0"/>
                      <TextBlock Text="Firma Electrónica Válida" FontSize="9.5" Foreground="#38A169" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>


              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Fichas y Tabla de Medicamentos -->
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                  
                  <!-- Fichas Superiores: Derechohabiente y Receta -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="14"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ficha 1: Derechohabiente (Campos idénticos a MedicineOutputWindow de IUBI) -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding Carnet}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Wine800Brush}"/>
                          <TextBlock Text="Identificación del Derechohabiente" Style="{StaticResource CardTitle}" Margin="0"/>
                        </DockPanel>

                        <DockPanel Margin="0,2,0,10">
                          <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource Rose100Brush}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding PacienteIniciales}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Wine800Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PacienteNombre}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Wine950Brush}"/>
                            <Border Background="{StaticResource Gold100Brush}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="0,3,0,0">
                              <TextBlock Text="{Binding Vigencia}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}"/>
                            </Border>
                          </StackPanel>
                        </DockPanel>

                        <Grid Margin="0,4,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="CURP" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding Curp}" FontWeight="SemiBold" FontSize="11"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="AFILIACIÓN" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding TipoAfiliacion}" FontWeight="SemiBold" FontSize="11"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="DEPENDENCIA" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding Dependencia}" FontWeight="SemiBold" FontSize="11"/>
                          </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,4,0,0">
                          <Border Background="{StaticResource Rose100Brush}" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Alergias}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Wine700Brush}"/>
                          </Border>
                          <Border Background="{StaticResource Sand50Brush}" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                            <TextBlock Text="Sin adeudos" FontSize="10" Foreground="#4A5568"/>
                          </Border>
                        </WrapPanel>

                        <!-- Selector de Beneficiario / Titular (Paridad MedicineOutputWindow) -->
                        <StackPanel Visibility="{Binding TieneBeneficiarios, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                          <TextBlock Text="ATENDER A (TITULAR O BENEFICIARIO)" Style="{StaticResource Caption}" Foreground="{StaticResource Wine900Brush}"/>
                          <ComboBox ItemsSource="{Binding BeneficiariosList}" SelectedItem="{Binding BeneficiarioSeleccionado}"
                                    DisplayMemberPath="DisplayText" Height="26" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <!-- Ficha 2: Receta Médica (Campos idénticos a MedicineOutputWindow de IUBI) -->
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                      <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding FolioReceta}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Wine800Brush}"/>
                          <TextBlock Text="Verificación de Receta Médica" Style="{StaticResource CardTitle}" Margin="0"/>
                        </DockPanel>

                        <Grid Margin="0,4,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="MÉDICO PRESCRIPTOR ACREDITADO" Style="{StaticResource Caption}"/>
                            <ComboBox ItemsSource="{Binding MedicosList}" SelectedItem="{Binding MedicoSeleccionado}"
                                      DisplayMemberPath="DisplayText" Height="26" FontSize="11" Margin="0,2,0,0"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="CÉDULA" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding CedulaMedico}" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding Diagnostico}" FontWeight="SemiBold" FontSize="11" Foreground="#4A5568"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="EMISIÓN" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding FechaEmision}" FontWeight="SemiBold" FontSize="11"/>
                          </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource Gold100Brush}" CornerRadius="6" Padding="10,5" Margin="0,4,0,0">
                          <TextBlock Text="✔ Receta válida · Firma electrónica verificada" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}"/>
                        </Border>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Barra de Escaneo Rápido de Código de Barras -->
                  <Border Background="{StaticResource Wine900Brush}" CornerRadius="8" Padding="16,10" Margin="0,14">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="+ Agregar" Style="{StaticResource GoldButton}" Margin="10,0,0,0" Command="{Binding EscanearCommand}"/>
                      <Border DockPanel.Dock="Right" Background="{StaticResource Gold100Brush}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                        <TextBlock Text="LECTOR ACTIVO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Wine900Brush}"/>
                      </Border>
                      <StackPanel DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Captura ágil para venta inmediata" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="Escanea código de barras o ingresa folio de receta (ej. C73344)" Foreground="{StaticResource Rose200Brush}" FontSize="10"/>
                      </StackPanel>
                      <Border Background="White" CornerRadius="6" Padding="10,5" Margin="8,0">
                        <TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" 
                                 BorderThickness="0" Background="Transparent" FontSize="13" VerticalAlignment="Center">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding EscanearCommand}"/>
                          </TextBox.InputBindings>
                        </TextBox>
                      </Border>
                    </DockPanel>
                  </Border>

                  <!-- Tabla de Medicamentos Prescritos -->
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="● Disponible" FontSize="11" Foreground="#38A169" FontWeight="SemiBold" Margin="0,0,12,0"/>
                          <TextBlock Text="● Parcial / vale" FontSize="11" Foreground="{StaticResource Gold500Brush}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="Medicamentos prescritos en receta" Style="{StaticResource CardTitle}" Margin="0,0,10,0"/>
                          <Border Background="{StaticResource Rose100Brush}" CornerRadius="10" Padding="8,2">
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource Wine800Brush}"><Run Text="{Binding Partidas.Count, Mode=OneWay}"/><Run Text=" partidas"/></TextBlock>
                          </Border>
                        </StackPanel>
                      </DockPanel>

                      <DataGrid ItemsSource="{Binding Partidas}" 
                                AutoGenerateColumns="False" 
                                CanUserAddRows="False" 
                                IsReadOnly="True"
                                HeadersVisibility="Column" 
                                GridLinesVisibility="Horizontal" 
                                HorizontalGridLinesBrush="{StaticResource Sand100Brush}"
                                BorderThickness="0" 
                                Background="White" 
                                RowBackground="White" 
                                RowHeight="52">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="CLAVE" Binding="{Binding Clave}" Width="105"/>
                          <DataGridTemplateColumn Header="MEDICAMENTO" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource InkBrush}"/>
                                  <TextBlock Text="{Binding Presentacion}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Header="DOSIS" Binding="{Binding Dosis}" Width="110"/>
                          <DataGridTextColumn Header="PRESC." Binding="{Binding Prescrita}" Width="55"/>
                          <DataGridTemplateColumn Header="EXIST." Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <Border Background="{StaticResource Sand50Brush}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Center">
                                  <TextBlock Text="{Binding Existencia}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Wine900Brush}"/>
                                </Border>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTemplateColumn Header="LOTE / CAD." Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Lote}" FontWeight="SemiBold" FontSize="11"/>
                                  <TextBlock Text="{Binding Caducidad}" FontSize="9" Foreground="#718096"/>
                                </StackPanel>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                          <DataGridTextColumn Header="PRECIO" Binding="{Binding Precio, StringFormat=C}" Width="80"/>
                          <DataGridTextColumn Header="IMPORTE" Binding="{Binding Importe, StringFormat=C}" Width="85"/>
                          <DataGridTemplateColumn Header="ACCIÓN" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                              <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                  <Button Content="Surtir" Style="{StaticResource SoftButton}"
                                          Visibility="{Binding EsBotonSurtir, Converter={StaticResource BoolToVis}}"
                                          Command="{Binding DataContext.SurtirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                          CommandParameter="{Binding}"/>

                                  <Button Content="Generar vale" Style="{StaticResource GoldButton}" FontSize="10" Padding="8,4"
                                          Visibility="{Binding EsBotonVale, Converter={StaticResource BoolToVis}}"
                                          Command="{Binding DataContext.GenerarValeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                          CommandParameter="{Binding}"/>

                                  <Border Background="{StaticResource Sand50Brush}" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="1" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center"
                                          Visibility="{Binding Surtida, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="✔ Surtido" FontSize="10" FontWeight="Bold" Foreground="#2F855A"/>
                                  </Border>
                                </StackPanel>
                              </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                          </DataGridTemplateColumn>
                        </DataGrid.Columns>
                      </DataGrid>

                      <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Right" Content="✔ Surtir disponibles" Style="{StaticResource SoftButton}" Command="{Binding SurtirDisponiblesCommand}"/>
                        <TextBlock Text="{Binding PartidasResumenDisponibles}" FontSize="11" Foreground="#718096" VerticalAlignment="Center"/>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Columna Derecha: Resumen de Cobro con Base 0% IVA -->
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                      <TextBlock DockPanel.Dock="Right" Text="{Binding FolioTicket}" FontSize="10" Foreground="#A0AEC0"/>
                      <TextBlock Text="Resumen de cobro" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <DockPanel Margin="0,6">
                      <TextBlock Text="Subtotal (Base 0% IVA)" FontSize="12" Foreground="#4A5568"/>
                      <TextBlock Text="{Binding Subtotal, StringFormat=C}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DockPanel Margin="0,6">
                      <TextBlock Text="Absorción institucional" Foreground="{StaticResource Wine800Brush}" FontWeight="SemiBold" FontSize="12"/>
                      <TextBlock Text="{Binding Absorcion, StringFormat=- {0:C}}" Foreground="{StaticResource Wine800Brush}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DockPanel Margin="0,6">
                      <TextBlock Text="Aportación del paciente" FontSize="12" Foreground="#4A5568"/>
                      <TextBlock Text="{Binding AportacionPaciente, StringFormat=C}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <!-- Cuadro Total Destacado -->
                    <Border Background="{StaticResource Rose100Brush}" CornerRadius="8" Padding="14" Margin="0,14">
                      <StackPanel>
                        <TextBlock Text="Total a cobrar al derechohabiente" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Wine800Brush}"/>
                        <TextBlock Text="Base 0% IVA según Ley del IVA para medicamentos" FontSize="9" Foreground="{StaticResource Wine700Brush}" Margin="0,1,0,4"/>
                        <TextBlock Text="{Binding AportacionPaciente, StringFormat=C}" FontFamily="Georgia" FontWeight="Bold" FontSize="26" Foreground="{StaticResource Wine900Brush}" HorizontalAlignment="Right"/>
                      </StackPanel>
                    </Border>

                    <TextBlock Text="MÉTODO DE PAGO" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding MetodosPago}" SelectedItem="{Binding MetodoPago}" Margin="0,0,0,14" Padding="8,6" FontSize="12"/>

                    <Button Content="💾 Guardar Operación" Style="{StaticResource PrimaryButton}" Command="{Binding GuardarCommand}" Margin="0,0,0,8"/>
                    <Button Content="🖨️ Imprimir Ticket" Style="{StaticResource GoldButton}" Command="{Binding ImprimirTicketCommand}" Margin="0,0,0,8"/>
                    <Button Content="✕ Cancelar" Style="{StaticResource OutlineButton}" Command="{Binding NuevaOperacionCommand}"/>

                    <TextBlock Text="Operación auditada y asociada al usuario activo en IUBIDB_FARMACIAS." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ======================================================== -->
          <!-- 2. VISTA: VALES SUBROGADOS DE FARMACIA EXTERNA (Frm_Vales) -->
          <!-- ======================================================== -->
          <Border Style="{StaticResource ValesViewStyle}">
            <StackPanel>
              <!-- Cabecera -->
              <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="🖨️ Reimprimir Vale" Style="{StaticResource OutlineButton}" Margin="0,0,10,0" Command="{Binding ReimprimirValeCommand}"/>
                  <Button Content="✔ Surtir Vale Activo" Style="{StaticResource PrimaryButton}" Command="{Binding SurtirValeCommand}"/>
                </StackPanel>

                <StackPanel>
                  <TextBlock Text="Control y Emisión de Vales Subrogados" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
                  <TextBlock Text="Canje y surtido de vales de farmacias privadas externas por desabasto en almacén central." Opacity="0.65" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>

              <!-- Tarjeta de Búsqueda y Verificación de Vale (Directa de CouponSupplyWindow) -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- Búsqueda rápida por Folio -->
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="ESCANEAR O INGRESAR NO. DE VALE" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Buscar" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding BuscarValePorFolioCommand}"/>
                      <Border Background="{StaticResource Sand50Brush}" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                        <TextBox Text="{Binding FiltroVale, UpdateSourceTrigger=PropertyChanged}" 
                                 FontSize="15" FontWeight="Bold" BorderThickness="0" Background="Transparent">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding BuscarValePorFolioCommand}"/>
                          </TextBox.InputBindings>
                        </TextBox>
                      </Border>
                    </DockPanel>
                    <TextBlock Text="Ejemplo: VAL-2026-0814 o teclea el carnet del paciente" FontSize="10" Foreground="#A0AEC0" Margin="0,4,0,0"/>
                  </StackPanel>

                  <!-- Ficha del Vale Activo -->
                  <Border Grid.Column="2" Background="{StaticResource Rose100Brush}" CornerRadius="8" Padding="14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="FOLIO VALE" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding ValeSeleccionado.NumeroVale}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Wine900Brush}"/>
                        <TextBlock Text="DERECHOHABIENTE" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding ValeSeleccionado.PacienteNombre}" FontWeight="SemiBold" FontSize="12"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="FARMACIA CONVENIO" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding ValeSeleccionado.FarmaciaSubrogada}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Wine800Brush}"/>
                        <TextBlock Text="VIGENCIA" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding ValeSeleccionado.FechaVencimiento, StringFormat='Vence: {0}'}" FontSize="11" FontWeight="Bold" Foreground="#C53030"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border Background="White" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                          <TextBlock Text="{Binding ValeSeleccionado.Estatus}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Wine900Brush}"/>
                        </Border>
                        <Button Content="Surtir Vale" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Command="{Binding SurtirValeCommand}" CommandParameter="{Binding ValeSeleccionado}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </Border>

              <!-- Tabla de Vales Registrados -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,25">
                <StackPanel>
                  <TextBlock Text="Padrón General de Vales Subrogados Emitidos" Style="{StaticResource CardTitle}"/>
                  <DataGrid ItemsSource="{Binding ValesList}" SelectedItem="{Binding ValeSeleccionado}"
                            AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Sand100Brush}"
                            Background="White" RowBackground="White" RowHeight="46" BorderThickness="0"
                            MaxHeight="540" EnableRowVirtualization="True"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="NO. VALE" Binding="{Binding NumeroVale}" Width="120" FontWeight="Bold"/>
                      <DataGridTextColumn Header="CARNET" Binding="{Binding Carnet}" Width="95"/>
                      <DataGridTemplateColumn Header="DERECHOHABIENTE" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding PacienteNombre}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PacienteNombre}"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="MEDICAMENTO" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Medicamento}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Medicamento}"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="RECETA" Binding="{Binding NumeroReceta}" Width="110"/>
                      <DataGridTemplateColumn Header="FARMACIA SUBROGADA" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding FarmaciaSubrogada}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FarmaciaSubrogada}"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="EMISIÓN" Binding="{Binding FechaEmision}" Width="95"/>
                      <DataGridTemplateColumn Header="VIGENCIA" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border Background="{StaticResource Gold100Brush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                              <TextBlock Text="{Binding DiasRestantes, StringFormat='{}{0} días'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Wine900Brush}"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="ESTATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border Background="{StaticResource Sand50Brush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                              <TextBlock Text="{Binding Estatus}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Wine900Brush}"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- ======================================================== -->
          <!-- 3. VISTA: INVENTARIO & LOTES FEFO (Frm_InventarioExistencias) -->
          <!-- ======================================================== -->
          <Border Style="{StaticResource InventarioViewStyle}">
            <StackPanel>
              <!-- Cabecera -->
              <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="📊 Exportar a Excel" Style="{StaticResource OutlineButton}" Margin="0,0,10,0" 
                          Command="{Binding ExportarExcelCommand}" CommandParameter="Inventario_FEFO"/>
                  <Button Content="+ Entrada de Lote" Style="{StaticResource PrimaryButton}"
                          Command="{Binding CambiarVistaCommand}" CommandParameter="Compras"/>
                </StackPanel>

                <StackPanel>
                  <TextBlock Text="Inventario Institucional y Lotes (Lógica FEFO)" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
                  <TextBlock Text="Control de existencias multi-almacén, semáforo de caducidad y medicamentos controlados." Opacity="0.65" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>

