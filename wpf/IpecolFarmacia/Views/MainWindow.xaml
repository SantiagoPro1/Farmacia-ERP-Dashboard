                        </StackPanel>
                      </DockPanel>

                      <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="TELÉFONO" Style="{StaticResource Caption}"/>
                          <TextBlock Text="{Binding PacienteSeleccionado.Telefono}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="DIAGNÓSTICO FRECUENTE" Style="{StaticResource Caption}"/>
                          <TextBlock Text="{Binding PacienteSeleccionado.DiagnosticoFrecuente}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                      </Grid>

                      <Button Content="📋 Cargar en Ventanilla para Surtir" Style="{StaticResource PrimaryButton}" 
                              Command="{Binding CargarPacienteEnVentanillaCommand}" CommandParameter="{Binding PacienteSeleccionado}"/>
                    </StackPanel>
                  </Border>

                  <!-- Historial de Medicamentos Entregados en los Últimos 15 Días (Directo de MedicineOutputWindow y CouponSupplyWindow) -->
