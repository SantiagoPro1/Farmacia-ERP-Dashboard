                    <TextBlock Text="CLAVES ACTIVAS" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding InventarioTotalClaves}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Wine900Brush}" Margin="0,4,0,0"/>
                    <TextBlock Text="Catálogo IUBIDB_FARMACIAS" FontSize="9.5" Foreground="#718096" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
