                          MaxHeight="550" EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="CLAVE" Binding="{Binding Clave}" Width="105" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="CÓDIGO BARRAS" Binding="{Binding CodigoBarras}" Width="120" Foreground="#718096"/>
                    <DataGridTemplateColumn Header="MEDICAMENTO &amp; PRESENTACIÓN" Width="2.2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel VerticalAlignment="Center" Margin="0,2">
                            <TextBlock Text="{Binding Nombre}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nombre}"/>
                            <TextBlock Text="{Binding Presentacion}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="SUSTANCIA ACTIVA" Width="1.8*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding SustanciaActiva}" VerticalAlignment="Center" FontSize="11" Foreground="#4A5568" TextTrimming="CharacterEllipsis" ToolTip="{Binding SustanciaActiva}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="LABORATORIO" Binding="{Binding Laboratorio}" Width="120" Foreground="#718096"/>
                    <DataGridTextColumn Header="STOCK FÍSICO" Binding="{Binding StockActual}" Width="95" FontWeight="Bold"/>
                    <DataGridTextColumn Header="DISPONIBLES" Binding="{Binding Disponibles}" Width="90"/>
                    <DataGridTextColumn Header="SURTIDOS HOY" Binding="{Binding Surtidos}" Width="95"/>
                    <DataGridTextColumn Header="LOTE FEFO" Binding="{Binding LoteFEFO}" Width="100"/>
                    <DataGridTextColumn Header="CADUCIDAD" Binding="{Binding CaducidadFEFO}" Width="95"/>
                    <DataGridTemplateColumn Header="ESTADO / VIGENCIA" Width="160">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Center">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="#DCFCE7"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SemaforoColor}" Value="#DD6B20">
                                    <Setter Property="Background" Value="#FEF3C7"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding SemaforoColor}" Value="#E53E3E">
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SemaforoTexto}" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#15803D"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding SemaforoColor}" Value="#DD6B20">
                                      <Setter Property="Foreground" Value="#B45309"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SemaforoColor}" Value="#E53E3E">
                                      <Setter Property="Foreground" Value="#B91C1C"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </StackPanel>
          </Border>

          <!-- ======================================================== -->
          <!-- 4. VISTA: KARDEX AUDITABLE (Frm_MovimientosInventario) -->
          <!-- ======================================================== -->
          <Border Style="{StaticResource KardexViewStyle}">
            <StackPanel>
              <!-- Cabecera -->
              <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="📥 Exportar Kardex a Excel" Style="{StaticResource OutlineButton}"
                        Command="{Binding ExportarExcelCommand}" CommandParameter="Kardex_Auditable"/>
                <StackPanel>
                  <TextBlock Text="Kardex Auditable de Movimientos" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
                  <TextBlock Text="Registro cronológico inmutable de entradas por compra, salidas por receta y vales." Opacity="0.65" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>

              <!-- Barra de Filtros -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="12">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Todos" Style="{StaticResource FilterChip}" Command="{Binding FiltrarKardexTipoCommand}" CommandParameter="Todos"/>
                    <Button Content="Salidas Receta" Style="{StaticResource FilterChip}" Command="{Binding FiltrarKardexTipoCommand}" CommandParameter="RECETA"/>
                    <Button Content="Salidas Vale" Style="{StaticResource FilterChip}" Command="{Binding FiltrarKardexTipoCommand}" CommandParameter="VALE"/>
                    <Button Content="Entradas Factura" Style="{StaticResource FilterChip}" Command="{Binding FiltrarKardexTipoCommand}" CommandParameter="FACTURA"/>
                  </StackPanel>

                  <Border Background="{StaticResource Sand50Brush}" BorderBrush="{StaticResource Sand100Brush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Width="360" HorizontalAlignment="Left">
                    <DockPanel>
                      <TextBlock Text="🔍 " FontSize="12" VerticalAlignment="Center" Foreground="#A0AEC0"/>
                      <TextBox Text="{Binding FiltroKardexTexto, UpdateSourceTrigger=PropertyChanged}" 
                               BorderThickness="0" Background="Transparent" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                </DockPanel>
              </Border>

              <!-- Tabla de Movimientos -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,25">
                <DataGrid ItemsSource="{Binding KardexFiltrado}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Sand100Brush}"
                          Background="White" RowBackground="White" RowHeight="46" BorderThickness="0"
                          MaxHeight="540" EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="FECHA / HORA" Binding="{Binding Fecha}" Width="140"/>
                    <DataGridTemplateColumn Header="TIPO MOVIMIENTO" Width="160">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border Background="{StaticResource Rose100Brush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding TipoMovimiento}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Wine900Brush}"/>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="MEDICAMENTO" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Medicamento}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Medicamento}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="LOTE" Binding="{Binding Lote}" Width="110"/>
                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding CantidadTexto}" Width="110" FontWeight="Bold"/>
                    <DataGridTemplateColumn Header="DOCUMENTO REFERENCIA" Width="1.5*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding DocumentoReferencia}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DocumentoReferencia}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="USUARIO / TERMINAL" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Usuario}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Usuario}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </StackPanel>
          </Border>

          <!-- ======================================================== -->
          <!-- 5. VISTA: COMPRAS Y ENTRADAS POR FACTURA (Frm_Compras) -->
          <!-- ======================================================== -->
          <Border Style="{StaticResource ComprasViewStyle}">
            <StackPanel>
              <!-- Cabecera -->
              <DockPanel Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Entradas de Medicamentos por Factura" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
                  <TextBlock Text="Recepción de proveedores mayoristas e ingreso de nuevos lotes a almacén central." Opacity="0.65" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>

              <!-- Formulario de Captura Rápida de Factura -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Registrar Recepción de Nueva Factura de Compra" Style="{StaticResource CardTitle}"/>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="1.5*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="100"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="FOLIO FACTURA" Style="{StaticResource Caption}"/>
                      <TextBox Text="{Binding NuevaFacturaFolio, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                      <TextBlock Text="PROVEEDOR" Style="{StaticResource Caption}"/>
                      <TextBox Text="{Binding NuevoProveedor, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                      <TextBlock Text="FÁRMACO A INGRESAR" Style="{StaticResource Caption}"/>
                      <TextBox Text="{Binding NuevoMedicamento, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                      <TextBlock Text="LOTE" Style="{StaticResource Caption}"/>
                      <TextBox Text="{Binding NuevoLote, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                      <TextBlock Text="CANTIDAD" Style="{StaticResource Caption}"/>
                      <TextBox Text="{Binding NuevaCantidad, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="10">
                      <TextBlock Text="COSTO U." Style="{StaticResource Caption}"/>
                      <TextBox Text="{Binding NuevoCosto, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="12" Content="+ Ingresar Factura" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom"
                            Command="{Binding AgregarNuevaFacturaCommand}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Tabla de Facturas Recibidas -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,25">
                <StackPanel>
                  <TextBlock Text="Historial de Facturas de Compra Registradas" Style="{StaticResource CardTitle}"/>
                  <DataGrid ItemsSource="{Binding ComprasList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Sand100Brush}"
                            Background="White" RowBackground="White" RowHeight="46" BorderThickness="0"
                            MaxHeight="540" EnableRowVirtualization="True"
                            VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                            VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="NO. FACTURA" Binding="{Binding NumeroFactura}" Width="130" FontWeight="Bold"/>
                      <DataGridTemplateColumn Header="PROVEEDOR" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Proveedor}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Proveedor}"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="FECHA RECEPCIÓN" Binding="{Binding FechaRecepcion}" Width="120"/>
                      <DataGridTextColumn Header="PIEZAS TOTALES" Binding="{Binding PiezasTotales}" Width="120"/>
                      <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=C}" Width="130" FontWeight="Bold"/>
                      <DataGridTemplateColumn Header="ESTATUS" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border Background="{StaticResource Rose100Brush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                              <TextBlock Text="{Binding Estatus}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource Wine900Brush}"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="OBSERVACIONES" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Observaciones}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Observaciones}"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- ======================================================== -->
          <!-- 6. VISTA: PADRÓN DE DERECHOHABIENTES (SeM_Derechohabientes) -->
