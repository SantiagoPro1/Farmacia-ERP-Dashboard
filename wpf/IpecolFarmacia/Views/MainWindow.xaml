              <DockPanel Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="+ Nuevo Titular" Style="{StaticResource OutlineButton}" Command="{Binding AbrirModalNuevoAfiliadoCommand}" Margin="0,0,8,0"/>
                  <Button Content="+ Nuevo Médico" Style="{StaticResource OutlineButton}" Command="{Binding AbrirModalNuevoMedicoCommand}" Margin="0,0,8,0"/>
                  <Button Content="+ Nuevo Fármaco" Style="{StaticResource OutlineButton}" Command="{Binding AbrirModalNuevoMedicamentoCommand}" Margin="0,0,8,0"/>
                  <Button Content="📋 Cargar en Ventanilla" Style="{StaticResource PrimaryButton}"
                          Command="{Binding CargarPacienteEnVentanillaCommand}" CommandParameter="{Binding PacienteSeleccionado}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="Padrón de Derechohabientes y Vigencias" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Wine950Brush}"/>
                  <TextBlock Text="Sincronizado con IUBIDB (Afi_Afiliados y SeM_Derechohabientes) para validación de derechos." Opacity="0.65" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>

              <!-- Barra de Búsqueda -->
              <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="12">
