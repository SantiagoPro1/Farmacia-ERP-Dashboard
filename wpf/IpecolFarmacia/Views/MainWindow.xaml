                          <DataGridTextColumn Header="RECETA" Binding="{Binding NumeroReceta}" Width="95"/>
                          <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding Medicamento}" Width="*"/>
                          <DataGridTextColumn Header="MÉDICO" Binding="{Binding Medico}" Width="*"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- ======================================================== -->
